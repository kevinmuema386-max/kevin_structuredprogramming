// QUESTION 1: ARRAY REVERSE DISPLAY
void reverseArray() {
    int n, i;

    printf("\nEnter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid array size!\n");
        return;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        printf("Element - %d: ", i);
        scanf("%d", &arr[i]);
    }

    printf("Values in array: ");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);

    printf("\nValues in reverse: ");
    for (i = n - 1; i >= 0; i--)
        printf("%d ", arr[i]);

    printf("\n");
}

// QUESTION 2: ARRAY SUM
void arraySum() {
    int n, i, sum = 0;

    printf("\nEnter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid array size!\n");
        return;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        printf("Element - %d: ", i);
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    printf("Sum of all elements: %d\n", sum);
}

// QUESTION 3: PRINT UNIQUE ELEMENTS
void uniqueElements() {
    int n, i, j, duplicate;

    printf("\nEnter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid array size!\n");
        return;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        printf("Element - %d: ", i);
        scanf("%d", &arr[i]);
    }

    printf("Unique elements: ");

    for (i = 0; i < n; i++) {
        duplicate = 0;

        for (j = 0; j < n; j++) {
            if (arr[i] == arr[j] && i != j) {
                duplicate = 1;
                break;
            }
        }

        if (duplicate == 0)
            printf("%d ", arr[i]);
    }

    printf("\n");
}

// QUESTION 4: MAXIMUM AND MINIMUM
void maxMin() {
    int n, i;

    printf("\nEnter number of elements: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid array size!\n");
        return;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        printf("Element - %d: ", i);
        scanf("%d", &arr[i]);
    }

    int max = arr[0];
    int min = arr[0];

    for (i = 1; i < n; i++) {
        if (arr[i] > max)
            max = arr[i];

        if (arr[i] < min)
            min = arr[i];
    }

    printf("Maximum element: %d\n", max);
    printf("Minimum element: %d\n", min);
}

// QUESTION 5: SORT ARRAY ASCENDING
void sortArray() {
    int n, i, j, temp;

    printf("\nEnter array size: ");
    scanf("%d", &n);

    if (n <= 0 || n > 100) {
        printf("Invalid array size!\n");
        return;
    }

    int arr[n];

    for (i = 0; i < n; i++) {
        printf("Element - %d: ", i);
        scanf("%d", &arr[i]);
    }

    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - 1 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("Sorted array: ");

    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);

    printf("\n");
}

// QUESTION 6: INSERT IN UNSORTED ARRAY
void insertArray() {
    int n, i, value, position;

    printf("\nEnter array size: ");
    scanf("%d", &n);

    if (n <= 0 || n > 99) {
        printf("Invalid array size!\n");
        return;
    }

    int arr[n + 1];

    for (i = 0; i < n; i++) {
        printf("Element - %d: ", i);
        scanf("%d", &arr[i]);
    }

    printf("Enter value to insert: ");
    scanf("%d", &value);

    printf("Enter position (1 to %d): ", n + 1);
    scanf("%d", &position);

    if (position < 1 || position > n + 1) {
        printf("Invalid position!\n");
        return;
    }

    printf("Current array: ");
    for (i = 0; i < n; i++)
        printf("%d ", arr[i]);

    for (i = n; i >= position; i--)
        arr[i] = arr[i - 1];

    arr[position - 1] = value;

    printf("\nNew array: ");

    for (i = 0; i < n + 1; i++)
        printf("%d ", arr[i]);

    printf("\n");
}

// QUESTION 7: CIRCULAR DATA LOGGER
void insertSample(int value) {
    buffer[next] = value;

    next = (next + 1) % BUFFER_SIZE;

    if (count < BUFFER_SIZE)
        count++;
}

void printSamples() {
    int i;
    int oldest;

    if (count == 0) {
        printf("Buffer is empty!\n");
        return;
    }

    oldest = (next - count + BUFFER_SIZE) % BUFFER_SIZE;

    printf("Samples (oldest to newest): ");

    for (i = 0; i < count; i++)
        printf("%d ", buffer[(oldest + i) % BUFFER_SIZE]);

    printf("\n");
}

void circularLogger() {
    int choice, value;

    do {
        printf("\n--- CIRCULAR DATA LOGGER ---\n");
        printf("1. Insert sample\n");
        printf("2. Display samples\n");
        printf("3. Return to main menu\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter sensor value: ");
                scanf("%d", &value);
                insertSample(value);
                printf("Sample inserted!\n");
                break;

            case 2:
                printSamples();
                break;

            case 3:
                printf("Returning to main menu...\n");
                break;

            default:
                printf("Invalid choice!\n");
        }

    } while (choice != 3);
}

